{
  "name": "intl-cache",
  "version": "0.0.0",
  "description": "Zero-dependency cache for shared Intl.* formatter instances",
  "keywords": [
    "cache",
    "datetimeformat",
    "formatter",
    "i18n",
    "intl",
    "numberformat"
  ],
  "homepage": "https://github.com/ericchernuka/intl-cache#readme",
  "bugs": "https://github.com/ericchernuka/intl-cache/issues",
  "license": "MIT",
  "author": "Eric Chernuka <ericchernuka@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericchernuka/intl-cache.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "lint": "vp lint",
    "test": "vp test",
    "test:coverage": "vp test --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^7.0.2",
    "vite-plus": "0.3.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
