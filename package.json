{
  "name": "i18n-cache",
  "version": "0.0.0",
  "description": "Zero-dependency cache for Intl.* formatter instances",
  "license": "MIT",
  "author": "Eric Chernuka <ericchernuka@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "lint": "vp lint",
    "test": "vp test",
    "test:coverage": "vp test --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^7.0.2",
    "vite-plus": "0.3.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.0.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
